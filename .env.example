# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Supabase secret key (sb_secret_...) or legacy service_role key. Server-only, never expose.
SUPABASE_SECRET_KEY=
# Password for the /admin page that lists quote requests and contact messages.
ADMIN_KEY=

# --- Alerts when a quote request or message arrives (optional) ---
# Resend API key (sending access is enough)
RESEND_API_KEY=
# Sender. Leave empty to use Resend's test sender (only delivers to the Resend account owner's email until a domain is verified).
RESEND_FROM=Pristine Custom <avisos@pristinecustomwheels.com>
# Who gets the email alerts, comma-separated. Defaults to pristinecustomwheels@gmail.com
NOTIFY_EMAIL=
# WhatsApp alerts via CallMeBot: comma-separated "phone:apikey" pairs, e.g. +19547981123:1234567
WHATSAPP_NOTIFY=
